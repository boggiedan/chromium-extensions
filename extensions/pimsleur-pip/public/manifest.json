{
  "manifest_version": 3,
  "name": "Pimsleur Picture in Picture",
  "description": "Pop the Pimsleur lesson player into a floating always-on-top window.",
  "version": "1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.pimsleur.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
